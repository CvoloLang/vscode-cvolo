{
  "$schema": "vscode://schemas/color-theme",
  "name": "Cvolo Visual Studio 2019 Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1E1E1E",
    "editor.foreground": "#D4D4D4",
    "editorBracketHighlight.foreground1": "#FFD700",
    "editorBracketHighlight.foreground2": "#179FFF",
    "editorBracketHighlight.foreground3": "#DA70D6",
    "editorBracketHighlight.foreground4": "#FFD700",
    "editorBracketHighlight.foreground5": "#179FFF",
    "editorBracketHighlight.foreground6": "#DA70D6"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#D4D4D4",
    "type": "#4EC9B0",
    "class": "#4EC9B0",
    "struct": "#4EC9B0",
    "enum": "#B8D7A3",
    "interface": "#B8D7A3",
    "typeParameter": "#B8D7A3",
    "function": "#DCDCAA",
    "method": "#DCDCAA",
    "operator": "#D4D4D4",
    "variable": "#9CDCFE",
    "parameter": "#9CDCFE",
    "property": "#D4D4D4",
    "enumMember": "#D4D4D4"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "scope": [
        "string",
        "entity.name.operator.custom-literal.string"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "entity.name.operator.custom-literal.number"
      ],
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.cvolo"
      ],
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "scope": [
        "keyword.other.cvolo",
        "storage.modifier.cvolo",
        "storage.type.primitive.cvolo",
        "storage.type.cvolo"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "entity.name.type.cvolo"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Cvolo namespace/import name",
      "scope": [
        "entity.name.namespace.cvolo",
        "entity.name.type.namespace.cvolo"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Cvolo generic angle brackets",
      "scope": [
        "punctuation.definition.generic.begin.cvolo",
        "punctuation.definition.generic.end.cvolo"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "Cvolo generic type parameter",
      "scope": "entity.name.type.type-parameter.cvolo",
      "settings": {
        "foreground": "#B8D7A3"
      }
    },
    {
      "scope": "entity.name.type.attribute.cvolo",
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": [
        "punctuation.definition.attribute.begin.cvolo",
        "punctuation.definition.attribute.end.cvolo"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Cvolo line comment",
      "scope": "comment.line.double-slash.cvolo",
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "name": "Cvolo documentation comment text",
      "scope": "comment.documentation.cvolo",
      "settings": {
        "foreground": "#608B4E"
      }
    },
    {
      "name": "Cvolo documentation comment prefix",
      "scope": "punctuation.definition.comment.cvolo",
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "name": "Cvolo documentation XML attribute",
      "scope": "comment.documentation.attribute.cvolo",
      "settings": {
        "foreground": "#C8C8C8"
      }
    },
    {
      "name": "Cvolo documentation XML CDATA",
      "scope": "comment.documentation.cdata.cvolo",
      "settings": {
        "foreground": "#E9D585"
      }
    },
    {
      "name": "Cvolo documentation XML delimiter",
      "scope": "comment.documentation.delimiter.cvolo",
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "name": "Cvolo documentation XML name",
      "scope": "comment.documentation.name.cvolo",
      "settings": {
        "foreground": "#569CD6"
      }
    }
  ]
}
