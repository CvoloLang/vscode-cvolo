{
  "$schema": "vscode://schemas/color-theme",
  "name": "Cvolo Visual Studio 2019 Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1E1E1E",
    "editor.foreground": "#D4D4D4",
    "editorBracketHighlight.foreground1": "#569CD6",
    "editorBracketHighlight.foreground2": "#C586C0",
    "editorBracketHighlight.foreground3": "#DCDCAA"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#D4D4D4",
    "type": "#4EC9B0",
    "struct": "#86C691",
    "enum": "#B8D7A3",
    "interface": "#B8D7A3",
    "typeParameter": "#B8D7A3",
    "function": "#DCDCAA",
    "method": "#DCDCAA",
    "operator": "#D4D4D4",
    "variable": "#9CDCFE",
    "parameter": "#9CDCFE",
    "property": "#D4D4D4",
    "enumMember": "#D4D4D4"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6A9955"
      }
    },
    {
      "scope": [
        "string",
        "entity.name.operator.custom-literal.string"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "entity.name.operator.custom-literal.number"
      ],
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.attribute"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.control.cvolo"
      ],
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "scope": [
        "keyword.other.cvolo",
        "storage.modifier.cvolo",
        "storage.type.primitive.cvolo",
        "storage.type.cvolo"
      ],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "scope": [
        "entity.name.type.cvolo",
        "entity.name.type.attribute.cvolo"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": "comment.line.documentation.cvolo",
      "settings": {
        "foreground": "#608B4E"
      }
    },
    {
      "scope": "comment.line.double-slash.cvolo",
      "settings": {
        "foreground": "#6A9955"
      }
    }
  ]
}
