{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cvolo",
  "scopeName": "source.cvolo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#raw-strings" },
    { "include": "#interpolated-strings" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#type-declarations" },
    { "include": "#keywords" },
    { "include": "#function-calls" },
    { "include": "#constants-uppercase" },
    { "include": "#type-references" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.cvolo", "match": "//.*$" },
        {
          "name": "comment.block.cvolo",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.cvolo" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.comment.end.cvolo" } }
        }
      ]
    },

    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.cvolo",
          "begin": "^\\s*\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "name": "entity.name.type.attribute.cvolo", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },

    "raw-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.cvolo",
          "match": "(@\\$?\"|\"@)(?:[^\"]|\"\")*\"",
          "captures": { "0": { "name": "punctuation.definition.string.begin.cvolo" } }
        }
      ]
    },

    "interpolated-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.cvolo",
          "begin": "\\$\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cvolo" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.string.end.cvolo" } },
          "patterns": [
            { "include": "#escape-sequences" },
            {
              "name": "meta.embedded.expression.cvolo",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [ { "include": "$self" } ]
            }
          ]
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cvolo",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cvolo" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.string.end.cvolo" } },
          "patterns": [ { "include": "#escape-sequences" } ]
        }
      ]
    },

    "escape-sequences": {
      "patterns": [
        { "name": "constant.character.escape.cvolo", "match": "\\\\(?:[0nrt'\"\\\\]|x[0-9a-fA-F]+)" }
      ]
    },

    "char-literals": {
      "patterns": [
        {
          "name": "string.quoted.single.cvolo",
          "match": "'(?:\\\\(?:[0nrt'\"\\\\]|x[0-9a-fA-F]+)|[^'\\\\\\r\\n])'"
        }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.cvolo",     "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*(?:[uU][lL]?|[lL][uU]?)?\\b" },
        { "name": "constant.numeric.binary.cvolo",  "match": "\\b0[bB][01](?:_?[01])*(?:[uU][lL]?|[lL][uU]?)?\\b" },
        { "name": "constant.numeric.float.cvolo",   "match": "\\b\\d(?:_?\\d)*\\.\\d(?:_?\\d)*(?:[eE][+-]?\\d+)?(?:[fFdD])?\\b" },
        { "name": "constant.numeric.float.cvolo",   "match": "\\b\\d(?:_?\\d)*[eE][+-]?\\d+(?:[fFdD])?\\b" },
        { "name": "constant.numeric.float.cvolo",   "match": "\\b\\d(?:_?\\d)*[fF]\\b" },
        { "name": "constant.numeric.integer.cvolo", "match": "\\b\\d(?:_?\\d)*(?:[uU][lL]?|[lL][uU]?)?\\b" }
      ]
    },

    "type-declarations": {
      "patterns": [
        {
          "name": "meta.type.declaration.cvolo",
          "match": "\\b(struct|union|enum|extension|interface|protocol|alias)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.cvolo" },
            "2": { "name": "entity.name.type.cvolo" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "storage.type.primitive.cvolo",
          "match": "\\b(?:int|uint|long|ulong|short|ushort|byte|sbyte|nint|nuint|float|double|bool|string|char|void)\\b"
        },
        {
          "name": "storage.modifier.cvolo",
          "match": "\\b(?:private|internal|public|unsafe|unbound|val|var|refvar|ref|global|embed|heap)\\b"
        },
        {
          "name": "keyword.control.cvolo",
          "match": "\\b(?:if|else|while|for|foreach|in|switch|case|default|break|continue|return|defer)\\b"
        },
        {
          "name": "keyword.other.cvolo",
          "match": "\\b(?:namespace|using|expose|extern|where|is|asm|volatile|alignstack|intel|nameof|typeof|panic)\\b"
        }
      ]
    },

    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.cvolo",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:<[^>]*>)?\\s*\\()"
        }
      ]
    },

    "constants-uppercase": {
      "patterns": [
        {
          "name": "constant.other.cvolo",
          "match": "\\b(?:[A-Z][A-Z0-9_]{2,}|GL_[A-Za-z0-9_]+|VK_[A-Za-z0-9_]+|CUDA_[A-Za-z0-9_]+)\\b"
        }
      ]
    },

    "type-references": {
      "patterns": [
        { "name": "entity.name.type.cvolo", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.cvolo", "match": "\\b(?:true|false|null)\\b" }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cvolo",
          "match": ">>>=|<<=|>>=|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|->|\\.\\.\\.|<<|>>|\\+=|-=|\\*=|/=|&=|\\|=|\\^=|[+\\-*/%&|^~!=<>]"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.cvolo", "match": "[(){}\\[\\];,.:?]" }
      ]
    }
  }
}
